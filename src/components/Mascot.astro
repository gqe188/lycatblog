---
/**
 * 小站看板猫「lycat」—— 原创简笔画小猫。
 * 线条颜色跟随 currentColor（自动适配明暗主题），可用 --m-fill 给脸部填底色。
 * size: 像素大小；mood: 'normal' | 'wink'
 */
interface Props {
  size?: number;
  mood?: 'normal' | 'wink';
  class?: string;
}
const { size = 120, mood = 'normal', class: cls = '' } = Astro.props;
---

<svg
  class:list={['mascot', cls]}
  width={size}
  height={size}
  viewBox="0 0 120 120"
  role="img"
  aria-label="lycat 看板猫"
  fill="none"
  stroke="currentColor"
  stroke-width="4.5"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <!-- 一笔画出的脑袋 + 耳朵 -->
  <path
    class="head"
    d="M21 76 C19 58 23 45 31 36 L27 13 L50 28 C56 26.5 64 26.5 70 28 L93 13 L89 36 C97 45 101 58 99 76 C97 98 80 107 60 107 C40 107 23 98 21 76 Z"
    fill="var(--m-fill, none)"></path>
  <!-- 耳朵里的一道 -->
  <path d="M33 22 L38 31 M87 22 L82 31" stroke-width="3" opacity=".55"></path>
  <!-- 眼睛 -->
  <g class="eyes" fill="currentColor" stroke="none">
    <ellipse class="eye" cx="44" cy="64" rx="4" ry="5.5"></ellipse>
    {mood === 'wink' ? <path d="M70 65 q6 -6.5 12 0" fill="none" stroke="currentColor" stroke-width="4" /> : <ellipse class="eye" cx="76" cy="64" rx="4" ry="5.5" />}
  </g>
  <!-- 腮红：三道小斜线 -->
  <path class="blush" d="M29 80 l3.5 -5 M35 80 l3.5 -5 M41 80 l3.5 -5 M75.5 80 l3.5 -5 M81.5 80 l3.5 -5 M87.5 80 l3.5 -5" stroke-width="2.6"></path>
  <!-- 鼻子 + ω 嘴 -->
  <path d="M57 75 h6 l-3 3 z" stroke-width="2.6" fill="currentColor"></path>
  <path d="M51 82 q4.5 5 9 0 q4.5 5 9 0" stroke-width="3.4"></path>
  <!-- 胡须 -->
  <path d="M5 68 L19 72 M5 80 L19 79 M115 68 L101 72 M115 80 L101 79" stroke-width="3"></path>
</svg>

<style>
  .mascot {
    display: block;
    overflow: visible;
  }
  .mascot .blush {
    stroke: var(--sakura, #ff6fae);
  }
  .mascot .eye {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 5.5s infinite;
  }
  .mascot .head {
    transform-origin: 60px 107px;
    animation: tilt 7s ease-in-out infinite;
  }
  @keyframes blink {
    0%,
    94%,
    100% {
      transform: scaleY(1);
    }
    97% {
      transform: scaleY(0.12);
    }
  }
  @keyframes tilt {
    0%,
    90%,
    100% {
      transform: rotate(0deg);
    }
    94% {
      transform: rotate(-2.5deg);
    }
  }
</style>
