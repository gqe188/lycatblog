---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import { formatDate, readingTime, tagSlug, type Post } from '../lib/site';

interface Props {
  post: Post;
  index?: number;
}
const { post, index = 0 } = Astro.props;
const { title, date, description, tags, cover } = post.data;
const mins = readingTime(post.body);
---

<article class="post-card card reveal" style={`animation-delay:${Math.min(index, 8) * 70}ms`}>
  <a class="stretch" href={`/posts/${post.id}/`} aria-label={title}></a>
  <div class="date" aria-hidden="true">
    <span class="md">{formatDate(date, 'short')}</span>
    <span class="y">{date.getUTCFullYear()}</span>
  </div>
  <div class="body">
    <h3 class="title">{title}</h3>
    {description && <p class="desc">{description}</p>}
    <div class="meta">
      <span class="m"><Icon name="clock" size={14} /> {mins} 分钟</span>
      <time class="m only-sm" datetime={date.toISOString()}><Icon name="calendar" size={14} /> {formatDate(date)}</time>
      {tags.map((t) => <a class="tag" href={`/tags/${tagSlug(t)}/`}>{t}</a>)}
    </div>
  </div>
  {
    cover && (
      <div class="cover">
        <Image src={cover} alt="" widths={[240, 480]} sizes="240px" loading="lazy" />
      </div>
    )
  }
</article>

<style>
  .post-card {
    position: relative;
    display: grid;
    grid-template-columns: 76px 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 20px 24px;
    transition:
      transform 0.25s,
      box-shadow 0.25s,
      border-color 0.25s;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--border-strong);
  }
  .post-card:hover .title {
    color: var(--sky);
  }
  .stretch {
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .meta a {
    position: relative;
    z-index: 2;
  }
  .date {
    display: grid;
    place-items: center;
    align-self: stretch;
    padding: 8px 0;
    border-right: 1px dashed var(--border-strong);
    font-family: var(--font-mono);
  }
  .md {
    font-size: 22px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.1;
  }
  .y {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.1em;
  }
  .title {
    margin: 0;
    font-size: 20px;
    line-height: 1.45;
    transition: color 0.2s;
  }
  .desc {
    margin: 6px 0 10px;
    color: var(--text-2);
    font-size: 15px;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    font-size: 13px;
    color: var(--muted);
  }
  .m {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--font-mono);
  }
  .only-sm {
    display: none;
  }
  .cover {
    width: 132px;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--border);
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s;
  }
  .post-card:hover .cover :global(img) {
    transform: scale(1.06);
  }
  @media (max-width: 640px) {
    .post-card {
      grid-template-columns: 1fr;
      padding: 18px;
    }
    .date {
      display: none;
    }
    .only-sm {
      display: inline-flex;
    }
    .cover {
      display: none;
    }
  }
</style>
