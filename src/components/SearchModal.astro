---
import Icon from './Icon.astro';
---

<dialog class="search" aria-label="站内搜索">
  <div class="panel">
    <div class="field">
      <Icon name="search" size={20} />
      <input type="search" placeholder="搜索文章、标签、内容…  (grep -i)" autocomplete="off" spellcheck="false" aria-label="搜索关键词" />
      <button class="esc" type="button" data-close aria-label="关闭">Esc</button>
    </div>
    <ul class="results" role="listbox" aria-label="搜索结果"></ul>
    <p class="hint">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span><span><kbd>Enter</kbd> 打开</span><span><kbd>/</kbd> 或 <kbd>Ctrl K</kbd> 唤起</span>
    </p>
  </div>
</dialog>

<script>
  type Doc = { title: string; url: string; date: string; tags: string[]; description: string; text: string };

  const dialog = document.querySelector<HTMLDialogElement>('dialog.search')!;
  const input = dialog.querySelector('input')!;
  const list = dialog.querySelector<HTMLUListElement>('.results')!;
  let docs: Doc[] | null = null;
  let active = 0;

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const mark = (s: string, q: string) => {
    if (!q) return esc(s);
    const i = s.toLowerCase().indexOf(q);
    if (i < 0) return esc(s);
    return esc(s.slice(0, i)) + '<mark>' + esc(s.slice(i, i + q.length)) + '</mark>' + esc(s.slice(i + q.length));
  };

  async function load() {
    if (docs) return docs;
    const res = await fetch('/search.json');
    docs = (await res.json()) as Doc[];
    return docs;
  }

  function render(q: string) {
    const all = docs ?? [];
    const query = q.trim().toLowerCase();
    const hits = !query
      ? all.slice(0, 6).map((d) => ({ d, snippet: d.description }))
      : all
          .map((d) => {
            const hay = [d.title, d.description, d.tags.join(' '), d.text].join('\n').toLowerCase();
            if (!query.split(/\s+/).every((w) => hay.includes(w))) return null;
            const first = query.split(/\s+/)[0];
            const i = d.text.toLowerCase().indexOf(first);
            const snippet = i >= 0 ? (i > 30 ? '…' : '') + d.text.slice(Math.max(0, i - 30), i + 70) + '…' : d.description;
            const score = (d.title.toLowerCase().includes(first) ? 10 : 0) + (d.tags.join(' ').toLowerCase().includes(first) ? 5 : 0);
            return { d, snippet, score };
          })
          .filter((x): x is NonNullable<typeof x> => !!x)
          .sort((a, b) => b.score - a.score);
    active = 0;
    if (!hits.length) {
      list.innerHTML = `<li class="empty"><code>grep: no match for "${esc(q)}"</code><br/>换个关键词试试喵～</li>`;
      return;
    }
    const first = query.split(/\s+/)[0] ?? '';
    list.innerHTML = hits
      .map(
        ({ d, snippet }, i) => `<li role="option" aria-selected="${i === 0}">
          <a href="${d.url}">
            <span class="t">${mark(d.title, first)}</span>
            <span class="s">${mark(snippet, first)}</span>
            <span class="m">${d.date}${d.tags.map((t) => ` · #${esc(t)}`).join('')}</span>
          </a></li>`,
      )
      .join('');
  }

  function setActive(n: number) {
    const items = [...list.querySelectorAll('li[role=option]')];
    if (!items.length) return;
    active = (n + items.length) % items.length;
    items.forEach((el, i) => el.setAttribute('aria-selected', String(i === active)));
    items[active].scrollIntoView({ block: 'nearest' });
  }

  async function open() {
    if (dialog.open) return;
    dialog.showModal();
    input.value = '';
    input.focus();
    await load();
    render(input.value);
  }

  document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', open));
  dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  input.addEventListener('input', () => docs && render(input.value));
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') (e.preventDefault(), setActive(active + 1));
    else if (e.key === 'ArrowUp') (e.preventDefault(), setActive(active - 1));
    else if (e.key === 'Enter') {
      const a = list.querySelectorAll<HTMLAnchorElement>('li[role=option] a')[active];
      if (a) location.href = a.href;
    }
  });
  addEventListener('keydown', (e) => {
    const t = e.target as HTMLElement;
    const typing = t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName));
    if ((e.key === 'k' && (e.ctrlKey || e.metaKey)) || (e.key === '/' && !typing)) {
      e.preventDefault();
      open();
    }
  });
</script>

<style>
  .search {
    width: min(640px, calc(100vw - 32px));
    max-height: min(560px, 80vh);
    margin: 12vh auto auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--surface-solid);
    color: var(--text);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .search::backdrop {
    background: rgba(10, 18, 40, 0.42);
    backdrop-filter: blur(4px);
  }
  .search[open] {
    animation: pop 0.22s cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.98);
    }
  }
  .panel {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    color: var(--sky);
    border-bottom: 1px solid var(--border);
  }
  input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 17px;
  }
  input::-webkit-search-cancel-button {
    display: none;
  }
  .esc {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 2px 8px;
    color: var(--muted);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
  }
  .results {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
  }
  .results :global(li a) {
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    border-radius: 12px;
    color: var(--text);
    text-decoration: none;
  }
  .results :global(li[aria-selected='true'] a),
  .results :global(li a:hover) {
    background: var(--sky-soft);
  }
  .results :global(.t) {
    font-size: 16px;
    font-weight: 600;
  }
  .results :global(.s) {
    font-size: 14px;
    color: var(--text-2);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .results :global(.m) {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
  .results :global(mark) {
    color: inherit;
    background: var(--sakura-soft);
    border-bottom: 2px solid var(--sakura);
  }
  .results :global(.empty) {
    padding: 28px 14px;
    text-align: center;
    color: var(--muted);
  }
  .hint {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin: 0;
    padding: 10px 16px;
    font-size: 12px;
    color: var(--muted);
    border-top: 1px solid var(--border);
  }
  kbd {
    font-family: var(--font-mono);
    font-size: 11px;
    padding: 0 5px;
    margin-right: 2px;
    border: 1px solid var(--border-strong);
    border-radius: 4px;
  }
</style>
