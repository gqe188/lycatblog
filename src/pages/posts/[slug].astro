---
import { render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { getPosts, formatDate, readingTime, tagSlug, type Post } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props {
  post: Post;
  newer?: Post;
  older?: Post;
}

const { post, newer, older } = Astro.props;
const { title, date, description, tags, cover } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 4);
const minDepth = Math.min(...toc.map((h) => h.depth), 4);
const mins = readingTime(post.body);
const chars = (post.body ?? '').replace(/\s/g, '').length;
const og = cover ? (await getImage({ src: cover, width: 1200, format: 'jpg' })).src : undefined;
---

<BaseLayout title={title} description={description} image={og} type="article">
  <div class="progress" aria-hidden="true"><span></span></div>

  <header class="post-head container">
    <a class="back" href="/posts/"><Icon name="arrowLeft" size={16} /> 文章列表</a>
    <div class="tags">
      {tags.map((t) => <a class="tag" href={`/tags/${tagSlug(t)}/`}>{t}</a>)}
    </div>
    <h1 class="title">{title}</h1>
    {description && <p class="desc">{description}</p>}
    <div class="meta">
      <span><Icon name="calendar" size={15} /> <time datetime={date.toISOString()}>{formatDate(date)}</time></span>
      <span><Icon name="clock" size={15} /> 约 {mins} 分钟</span>
      <span><Icon name="terminal" size={15} /> {chars.toLocaleString()} 字符</span>
    </div>
  </header>

  {
    cover && (
      <div class="container">
        <div class="cover">
          <Image src={cover} alt="" widths={[720, 1120]} sizes="(max-width: 1120px) 100vw, 1120px" loading="eager" />
        </div>
      </div>
    )
  }

  <div class:list={['container', 'layout', { 'has-toc': toc.length > 1 }]}>
    <article class="prose card article">
      <Content />
      <div class="end">
        <span>— EOF —</span>
      </div>
    </article>

    {
      toc.length > 1 && (
        <aside class="toc" aria-label="目录">
          <div class="toc-inner card">
            <p class="toc-title">
              <Icon name="menu" size={15} /> 目录
            </p>
            <ol>
              {toc.map((h) => (
                <li style={`--d:${h.depth - minDepth}`}>
                  <a href={`#${h.slug}`} data-id={h.slug}>
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </aside>
      )
    }
  </div>

  <nav class="container pager" aria-label="上一篇 / 下一篇">
    {
      older ? (
        <a class="card pg prev" href={`/posts/${older.id}/`}>
          <span class="lbl">
            <Icon name="arrowLeft" size={14} /> 上一篇
          </span>
          <span class="t">{older.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
    {
      newer ? (
        <a class="card pg next" href={`/posts/${newer.id}/`}>
          <span class="lbl">
            下一篇 <Icon name="arrow" size={14} />
          </span>
          <span class="t">{newer.data.title}</span>
        </a>
      ) : (
        <span />
      )
    }
  </nav>

  <dialog class="zoom" aria-label="图片预览"><img alt="" /></dialog>
</BaseLayout>

<script>
  // 阅读进度
  const bar = document.querySelector<HTMLElement>('.progress span')!;
  const article = document.querySelector<HTMLElement>('.article')!;
  const onScroll = () => {
    const r = article.getBoundingClientRect();
    const total = r.height - innerHeight * 0.6;
    const p = Math.min(1, Math.max(0, -r.top / Math.max(total, 1)));
    bar.style.transform = `scaleX(${p})`;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // 标题锚点
  article.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]').forEach((h) => {
    const a = document.createElement('a');
    a.href = `#${h.id}`;
    a.className = 'heading-anchor';
    a.setAttribute('aria-label', '本节链接');
    a.textContent = '#';
    h.append(a);
  });

  // 代码复制
  article.querySelectorAll<HTMLButtonElement>('.code-block .copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const code = btn.closest('.code-block')!.querySelector('pre')!.innerText;
      try {
        await navigator.clipboard.writeText(code);
        btn.textContent = 'copied ✓';
        btn.classList.add('done');
      } catch {
        btn.textContent = 'failed';
      }
      setTimeout(() => {
        btn.textContent = 'copy';
        btn.classList.remove('done');
      }, 1600);
    });
  });

  // 图片放大
  const zoom = document.querySelector<HTMLDialogElement>('dialog.zoom')!;
  const zimg = zoom.querySelector('img')!;
  article.querySelectorAll<HTMLImageElement>('img').forEach((img) => {
    img.addEventListener('click', () => {
      zimg.src = img.currentSrc || img.src;
      zimg.alt = img.alt;
      zoom.showModal();
    });
  });
  zoom.addEventListener('click', () => zoom.close());

  // 目录高亮
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.toc a')];
  if (links.length) {
    const map = new Map(links.map((l) => [l.dataset.id, l]));
    const visible = new Set<string>();
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => (e.isIntersecting ? visible.add(e.target.id) : visible.delete(e.target.id)));
        const heads = [...article.querySelectorAll<HTMLElement>('h2[id], h3[id], h4[id]')];
        let current = heads.find((h) => visible.has(h.id))?.id;
        if (!current) current = heads.filter((h) => h.getBoundingClientRect().top < 120).pop()?.id;
        links.forEach((l) => l.classList.toggle('active', l.dataset.id === current));
        const act = current ? map.get(current) : undefined;
        act?.scrollIntoView({ block: 'nearest' });
      },
      { rootMargin: '-80px 0px -60% 0px' },
    );
    article.querySelectorAll('h2[id], h3[id], h4[id]').forEach((h) => io.observe(h));
  }
</script>

<style>
  .progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    height: 3px;
    pointer-events: none;
  }
  .progress span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--sky), var(--sakura));
    transform-origin: 0 50%;
    transform: scaleX(0);
  }
  .post-head {
    max-width: calc(var(--prose) + 80px);
    padding-top: clamp(28px, 5vw, 56px);
    padding-bottom: 28px;
    text-align: center;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    color: var(--muted);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    margin-top: 18px;
  }
  .title {
    margin: 14px 0 0;
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1.3;
  }
  .desc {
    margin: 14px auto 0;
    max-width: 620px;
    color: var(--text-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  .meta span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .cover {
    max-width: 960px;
    margin: 0 auto 28px;
    aspect-ratio: 21 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow);
  }
  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--prose));
    justify-content: center;
    gap: 32px;
  }
  .layout.has-toc {
    grid-template-columns: minmax(0, var(--prose)) 240px;
  }
  .article {
    padding: clamp(22px, 5vw, 48px);
    min-width: 0;
  }
  .end {
    margin-top: 48px;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--muted);
  }
  .toc {
    position: relative;
  }
  .toc-inner {
    position: sticky;
    top: calc(var(--header-h) + 20px);
    max-height: calc(100vh - var(--header-h) - 40px);
    overflow-y: auto;
    padding: 16px 12px 16px 16px;
  }
  .toc-title {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0 0 8px;
    font-weight: 700;
    font-size: 15px;
  }
  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    padding-left: calc(var(--d) * 14px);
  }
  .toc a {
    display: block;
    padding: 4px 10px;
    border-left: 2px solid var(--border);
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-2);
    transition: all 0.2s;
  }
  .toc a:hover {
    color: var(--sky);
    text-decoration: none;
  }
  .toc a.active {
    color: var(--sky);
    border-left-color: var(--sakura);
    background: var(--sky-soft);
    border-radius: 0 8px 8px 0;
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    max-width: calc(var(--prose) + 272px + 64px);
    margin-top: 32px;
  }
  .pg {
    display: grid;
    gap: 4px;
    padding: 16px 20px;
    color: var(--text);
    transition: all 0.2s;
  }
  .pg:hover {
    text-decoration: none;
    border-color: var(--sky);
    transform: translateY(-2px);
  }
  .pg.next {
    text-align: right;
  }
  .lbl {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    color: var(--muted);
  }
  .next .lbl {
    justify-content: flex-end;
  }
  .t {
    font-weight: 600;
  }
  .zoom {
    max-width: 96vw;
    max-height: 94vh;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-out;
  }
  .zoom::backdrop {
    background: rgba(6, 10, 24, 0.82);
    backdrop-filter: blur(6px);
  }
  .zoom img {
    display: block;
    max-width: 96vw;
    max-height: 94vh;
    border-radius: 10px;
  }
  @media (max-width: 1040px) {
    .layout.has-toc {
      grid-template-columns: minmax(0, var(--prose));
    }
    .toc {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pg.next {
      text-align: left;
    }
    .next .lbl {
      justify-content: flex-start;
    }
  }
</style>
