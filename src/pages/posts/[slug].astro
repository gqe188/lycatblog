---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllPosts, formatDisplayDate, type PostItem } from '../../lib/content';
import { renderMarkdown } from '../../lib/markdown';

export function getStaticPaths() {
  const posts = getAllPosts();
  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      prevPost: index < posts.length - 1 ? posts[index + 1] : null,
      nextPost: index > 0 ? posts[index - 1] : null,
    },
  }));
}

interface Props {
  post: PostItem;
  prevPost: PostItem | null;
  nextPost: PostItem | null;
}

const { post, prevPost, nextPost } = Astro.props;
const { html, headings } = await renderMarkdown(post.markdown);
---

<BaseLayout title={`${post.title} · lycat && 475`} description={post.excerpt}>
  <!-- Top Reading Progress Bar -->
  <div class="fixed top-16 left-0 right-0 z-30 h-[2.5px] bg-transparent pointer-events-none">
    <div
      id="reading-progress"
      class="h-full w-0 bg-gradient-to-r from-sky-500 via-cyan-400 to-rose-500 transition-[width] duration-75"
    ></div>
  </div>

  <article class="max-w-6xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-10">
    <!-- Breadcrumb -->
    <nav aria-label="面包屑" class="flex items-center gap-2 text-xs font-mono text-slate-500 dark:text-slate-400 mb-6">
      <a href="/" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">首页</a>
      <span>/</span>
      <a href="/posts" class="hover:text-sky-600 dark:hover:text-sky-400 transition-colors">文章</a>
      <span>/</span>
      <span class="text-slate-700 dark:text-slate-200 truncate">{post.slug}</span>
    </nav>

    <!-- Article Header Card -->
    <header class="surface-card rounded-3xl p-6 sm:p-9 mb-10">
      <div class="flex flex-wrap items-center gap-2.5 text-xs font-mono text-slate-500 dark:text-slate-400 mb-4">
        <span class="px-2.5 py-0.5 rounded-md bg-sky-500/12 text-sky-700 dark:text-sky-300 border border-sky-500/20 font-semibold">
          {post.category}
        </span>
        <span>发布于 {formatDisplayDate(post.date)}</span>
        <span>·</span>
        <span>约 {post.totalWords} 字</span>
        <span>·</span>
        <span>预计阅读 {post.readingMinutes} 分钟</span>
      </div>

      <h1 class="text-2xl sm:text-4xl font-bold tracking-tight text-slate-900 dark:text-white leading-tight">
        {post.title}
      </h1>

      <div class="mt-5 flex flex-wrap items-center gap-2">
        {post.tags.map((tag) => (
          <a
            href={`/posts?tag=${encodeURIComponent(tag)}`}
            class="px-2.5 py-1 rounded-lg text-xs font-mono bg-slate-100 dark:bg-slate-800/80 text-slate-600 dark:text-slate-300 hover:bg-sky-500/12 hover:text-sky-600 dark:hover:text-sky-300 transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>
    </header>

    <!-- Content + Sticky TOC Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class={headings.length > 0 ? 'lg:col-span-9 min-w-0' : 'lg:col-span-10 lg:col-start-2 min-w-0'}>
        <div
          id="article-content"
          class="surface-card rounded-3xl p-6 sm:p-9 editorial-prose max-w-none"
          set:html={html}
        />

        <!-- Prev / Next Navigation -->
        <div class="mt-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
          {prevPost ? (
            <a
              href={`/posts/${prevPost.slug}`}
              class="group surface-card surface-card-hover rounded-2xl p-5 flex flex-col justify-between"
            >
              <span class="text-xs font-mono text-slate-400">← 上一篇</span>
              <span class="mt-2 font-semibold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                {prevPost.title}
              </span>
            </a>
          ) : (
            <div />
          )}

          {nextPost ? (
            <a
              href={`/posts/${nextPost.slug}`}
              class="group surface-card surface-card-hover rounded-2xl p-5 flex flex-col justify-between text-right"
            >
              <span class="text-xs font-mono text-slate-400">下一篇 →</span>
              <span class="mt-2 font-semibold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                {nextPost.title}
              </span>
            </a>
          ) : (
            <a
              href="/posts"
              class="group surface-card surface-card-hover rounded-2xl p-5 flex flex-col justify-between text-right"
            >
              <span class="text-xs font-mono text-slate-400">返回列表 →</span>
              <span class="mt-2 font-semibold text-slate-900 dark:text-white group-hover:text-sky-600 dark:group-hover:text-sky-400 transition-colors">
                查看全部文章归档
              </span>
            </a>
          )}
        </div>
      </div>

      <!-- Sticky Desktop Table of Contents -->
      {headings.length > 0 && (
        <aside class="hidden lg:block lg:col-span-3 sticky top-24">
          <div class="surface-card rounded-2xl p-5">
            <div class="font-mono text-[11px] uppercase tracking-widest text-slate-400 mb-3 flex items-center justify-between">
              <span>ON THIS PAGE</span>
              <span>目录</span>
            </div>
            <ul id="toc-list" class="space-y-1.5 text-xs">
              {headings.map((h) => (
                <li class={h.depth >= 4 ? 'pl-3.5' : h.depth === 3 ? 'pl-2' : ''}>
                  <a
                    href={`#${h.slug}`}
                    data-toc-link={h.slug}
                    class="block py-1 text-slate-500 dark:text-slate-400 hover:text-sky-600 dark:hover:text-sky-400 transition-colors truncate border-l-2 border-transparent pl-2.5"
                  >
                    {h.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      )}
    </div>
  </article>

  <!-- Inline Image Lightbox Modal for Article Screenshots -->
  <div
    id="article-img-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-slate-950/90 backdrop-blur-md p-4 sm:p-8 cursor-zoom-out"
    role="dialog"
    aria-modal="true"
    aria-label="放大查看文章图片"
  >
    <img
      id="article-img-preview"
      src=""
      alt=""
      class="max-w-full max-h-[88vh] rounded-xl shadow-2xl object-contain"
    />
  </div>

  <script is:inline>
    (function () {
      // 1. Reading progress bar
      const bar = document.getElementById('reading-progress');
      const updateProgress = () => {
        const doc = document.documentElement;
        const max = doc.scrollHeight - doc.clientHeight;
        const pct = max > 0 ? Math.min(100, Math.max(0, (window.scrollY / max) * 100)) : 0;
        if (bar) bar.style.width = pct + '%';
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();

      // 2. Copy code button handler
      document.querySelectorAll('[data-copy-code="true"]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const frame = btn.closest('.code-frame');
          const code = frame?.querySelector('pre code')?.textContent || '';
          try {
            await navigator.clipboard.writeText(code);
            const orig = btn.textContent;
            btn.textContent = 'Copied ✓';
            setTimeout(() => {
              btn.textContent = orig || 'Copy';
            }, 1600);
          } catch {}
        });
      });

      // 3. Article image zoom lightbox
      const modal = document.getElementById('article-img-modal');
      const preview = document.getElementById('article-img-preview');
      document.querySelectorAll('#article-content img[data-zoomable="true"]').forEach((img) => {
        img.addEventListener('click', () => {
          if (!modal || !preview) return;
          preview.setAttribute('src', img.getAttribute('src') || '');
          preview.setAttribute('alt', img.getAttribute('alt') || '');
          modal.classList.remove('hidden');
          modal.classList.add('flex');
          document.body.style.overflow = 'hidden';
        });
      });
      const closeModal = () => {
        if (!modal) return;
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      };
      modal?.addEventListener('click', closeModal);
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeModal();
      });

      // 4. TOC Scroll-spy
      const tocLinks = Array.from(document.querySelectorAll('[data-toc-link]'));
      if (tocLinks.length > 0) {
        const headingEls = tocLinks
          .map((link) => document.getElementById(link.getAttribute('data-toc-link') || ''))
          .filter(Boolean);

        const setActive = (id) => {
          tocLinks.forEach((link) => {
            const match = link.getAttribute('data-toc-link') === id;
            link.classList.toggle('text-sky-600', match);
            link.classList.toggle('dark:text-sky-400', match);
            link.classList.toggle('border-sky-500', match);
            link.classList.toggle('font-medium', match);
            link.classList.toggle('border-transparent', !match);
          });
        };

        const observer = new IntersectionObserver(
          (entries) => {
            const visible = entries.find((e) => e.isIntersecting);
            if (visible?.target?.id) setActive(visible.target.id);
          },
          { rootMargin: '-80px 0px -70% 0px' }
        );
        headingEls.forEach((el) => observer.observe(el));
      }
    })();
  </script>
</BaseLayout>
